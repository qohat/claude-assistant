# /etc/ai-home.env — credenciales del servicio (root:root, chmod 600)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Tokens OAuth de suscripción (claude setup-token). El fallback es opcional.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
CLAUDE_CODE_OAUTH_TOKEN_FALLBACK=sk-ant-oat01-...
# Directorio de datos (memoria de agentes, engram, repos, estado)
AI_HOME_DATA=/ai-home
# Ruta del binario engram si no está en el PATH (setup.sh lo deja en /usr/local/bin)
#AI_HOME_ENGRAM_BIN=/usr/local/bin/engram
# Auto-continuaciones al agotar maxTurns (default 2; 0 = deshabilitado)
#AI_HOME_MAX_CONTINUES=2
# Reintentos con backoff ante errores transitorios (default 3)
#AI_HOME_TRANSIENT_RETRIES=3
