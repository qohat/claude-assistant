# Para desarrollo local (en producción systemd usa /etc/ai-home.env).
# Ver deploy/ai-home.env.example — mismas variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_FALLBACK=
AI_HOME_DATA=/ai-home
# Modo consola: 1 = stdin/stdout en vez de Telegram (pruebas locales)
#AI_HOME_CONSOLE=1
# Ruta del binario engram si no está en el PATH
#AI_HOME_ENGRAM_BIN=/usr/local/bin/engram
# Auto-continuaciones al agotar maxTurns (default 2; 0 = deshabilitado)
#AI_HOME_MAX_CONTINUES=2
# Reintentos con backoff ante errores transitorios (default 3)
#AI_HOME_TRANSIENT_RETRIES=3
